# Use Ubuntu 22.04 as base image
FROM ubuntu:22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive

# Install basic GUI applications for testing
RUN apt update && apt install -y \
    x11-apps \
    xterm \
    gedit \
    firefox \
    && rm -rf /var/lib/apt/lists/*

# Create a test user with UID 1000
RUN useradd -m -u 1000 -s /bin/bash testuser

# Create entrypoint script to handle user ID mapping
RUN echo '#!/bin/bash\n\
if [ -n "$LOCAL_USER_ID" ]; then\n\
    # Only change user ID if it is different\n\
    if [ "$(id -u testuser)" != "$LOCAL_USER_ID" ]; then\n\
        usermod -u $LOCAL_USER_ID testuser\n\
        groupmod -g $LOCAL_USER_ID testuser\n\
    fi\n\
fi\n\
\n\
# Set proper ownership of home directory (skip workspace if permission denied)\n\
chown -R testuser:testuser /home/testuser 2>/dev/null || true\n\
\n\
# Export DISPLAY to user environment\n\
export DISPLAY=$DISPLAY\n\
\n\
# Switch to testuser and execute command with proper terminal setup\n\
exec su - testuser -c "export DISPLAY=$DISPLAY && exec $*"\n\
' > /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh

# Set working directory
WORKDIR /home/testuser

# Use entrypoint script
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Default command - start xterm
CMD ["xterm"] 